#!/usr/bin/expect -f

# teardown-cluster.exp — Reset TuringPi cluster to a re-bootstrappable state.
#
# Reverses Phase A: stops the registry, resets node passwords to ubuntu:ubuntu,
# resets hostnames, removes /etc/hosts entries, gracefully shuts down nodes,
# and powers them off via the BMC.
#
# Designed for scratch-reinstall testing — after a successful teardown the
# bootstrap script can be rerun from A1 on a clean slate.
#
# Usage:
#   ./teardown-cluster.exp [options]
#
# Options:
#   --dry-run                Print actions without making changes
#   --from STAGE             Start from this stage (default: first)
#   --to STAGE               Stop after this stage (default: last)
#   --password PASS          Current node password (prompted if omitted)
#   --remove-docker          Also uninstall Docker from the registry node
#   --keep-hostname          Skip hostname reset (Phase A5 overwrites it anyway)
#   --help, --usage          Show this message

# ---------- Defaults ----------
set SUBNET "192.168.1.0/24"
set NODE_COUNT 4
set NODE_PREFIX "rk1-node"
set DEFAULT_USER "ubuntu"
set DEFAULT_PASS "ubuntu"        ;# password we're resetting BACK TO
set CURRENT_PASS ""              ;# password set during bootstrap (prompted)
set REGISTRY_NODE_IDX 1
set REGISTRY_PORT 5000
set STATE_FILE "./bootstrap-state.kv"
set REMOVE_DOCKER 0
set KEEP_HOSTNAME 0
set BMC_HOST ""                  ;# restored from state; passed as --host to tpi

# ---------- Stage Registry ----------
set STAGES {
  T1_load_state
  T2_verify_connectivity
  T3_stop_registry
  T4_reset_passwords
  T5_reset_hostnames
  T6_clean_laptop_hosts
  T7_poweroff_nodes
  T8_clear_state
}

# ---------- utils (shared with bootstrap) ----------
proc say {msg} { puts "\n==> $msg" }
proc sh {cmd} {
  set rc [catch {set f [open "|$cmd 2>@1" r]; set out [read $f]; close $f; return $out} out]
  if {$rc} { return "" }
  return $out
}
proc ask_secret {prompt} {
  stty -echo
  send_user $prompt
  expect_user -re "(.*)\n"
  stty echo
  send_user "\n"
  return $expect_out(1,string)
}
proc die {msg} { puts stderr "ERROR: $msg"; exit 1 }

proc print_help {} {
  upvar STAGES STAGES
  puts "TuringPi Cluster Teardown\n"
  puts "Resets nodes to a re-bootstrappable state (ubuntu:ubuntu, no registry,\n/etc/hosts cleaned, nodes powered off).\n"
  puts "Usage:"
  puts "  ./teardown-cluster.exp \[--dry-run\] \[--from <STAGE>\] \[--to <STAGE>\]"
  puts "  ./teardown-cluster.exp \[--password PASS\] \[--remove-docker\] \[--keep-hostname\]"
  puts ""
  puts "Options:"
  puts "  --dry-run            Print actions without making changes"
  puts "  --from STAGE         Start from a specific stage"
  puts "  --to STAGE           Stop after a specific stage"
  puts "  --password PASS      Current node password (prompted if omitted)"
  puts "  --remove-docker      Also uninstall Docker from the registry node"
  puts "  --keep-hostname      Skip hostname reset (next bootstrap overwrites anyway)"
  puts "  --help, --usage      Show this message"
  puts ""
  puts "Stages:"
  foreach s $STAGES { puts "  - $s" }
  puts ""
  puts "State file: $::STATE_FILE (cleared in T8)"
}

# ---------- State helpers (shared with bootstrap) ----------
proc kv_load {file} {
  set m [dict create]
  if {[file exists $file]} {
    set f [open $file r]
    while {[gets $f line] >= 0} {
      set line [string trim $line]
      if {$line eq "" || [string match "#*" $line]} continue
      if {[regexp {^([^=]+)=(.*)$} $line -> k v]} {
        dict set m [string trim $k] [string trim $v]
      }
    }
    close $f
  }
  return $m
}
proc state_get {m key default} {
  if {[dict exists $m $key]} { return [dict get $m $key] }
  return $default
}

# ---------- SSH helpers ----------
proc ssh_shell {ip user pass commands} {
  spawn ssh -tt -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null $user@$ip
  expect {
    -re "(P|p)assword:"     { send "$pass\r"; exp_continue }
    -re "Are you sure.*"    { send "yes\r";   exp_continue }
    -re "\\$ "              { }
    timeout                 { return 1 }
    eof                     { return 1 }
  }
  foreach c $commands {
    send -- "$c\r"
    expect {
      -re "(?i)\\[sudo\\] password for $user:" { send -- "$pass\r"; exp_continue }
      -re "\\$ "  { }
      timeout     { return 1 }
    }
  }
  send -- "exit\r"
  expect eof
  return 0
}

proc ssh_reachable {ip user pass} {
  set rc [catch {
    spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
              -o ConnectTimeout=3 -o BatchMode=no $user@$ip "echo ok"
    expect {
      -re "(P|p)assword:" { send "$pass\r"; exp_continue }
      -re "Are you sure.*" { send "yes\r"; exp_continue }
      "ok"    { return 0 }
      timeout { catch {close}; return 1 }
      eof     { return 1 }
    }
  } err]
  if {$rc} { return 1 }
  return 0
}

# Scan subnet for IPs that have port 22 open.
proc discover_nodes {subnet} {
  set ips {}
  set out [sh "nmap -sn $subnet | grep 'Nmap scan report for'"]
  foreach line [split $out "\n"] {
    if {[regexp {Nmap scan report for \S+ \(([\d\.]+)\)} $line -> ip]} {
      lappend ips $ip
    } elseif {[regexp {Nmap scan report for ([\d\.]+)} $line -> ip]} {
      lappend ips $ip
    }
  }
  set good {}
  foreach ip $ips {
    set chk [sh "timeout 1 bash -c 'echo >/dev/tcp/$ip/22' 2>/dev/null && echo ok || echo no"]
    if {[string match *ok* $chk]} { lappend good $ip }
  }
  return $good
}

# SSH to $ip, run hostname, return 1 if it matches $name.
proc node_at_ip {ip name user pass} {
  set found ""
  catch {
    spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
              -o ConnectTimeout=3 $user@$ip "hostname"
    expect {
      -re "(P|p)assword:"    { send "$pass\r"; exp_continue }
      -re "Are you sure.*"   { send "yes\r";   exp_continue }
      -re {([^\r\n]+)\r?\n}  { set found $expect_out(1,string); exp_continue }
      timeout                { catch {close} }
      eof                    { }
    }
  }
  return [expr {[string trim $found] eq $name}]
}

# Scan $subnet and return the IP whose SSH hostname == $name, or "" if not found.
proc find_node_ip {name subnet user pass} {
  foreach ip [discover_nodes $subnet] {
    if {[node_at_ip $ip $name $user $pass]} { return $ip }
  }
  return ""
}

# Poll until SSH on $ip stops responding (node has shut down).
# Returns 1 if node went away within $deadline_s, 0 if it didn't.
# No explicit sleep — each failed SSH attempt takes ~ConnectTimeout seconds.
proc wait_for_ssh_gone {ip user deadline_s} {
  set deadline [expr {[clock seconds] + $deadline_s}]
  while {[clock seconds] < $deadline} {
    set rc [catch {exec ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                            -o ConnectTimeout=2 -o BatchMode=yes \
                            $user@$ip echo ping 2>/dev/null} out]
    if {$rc} { return 1 }
  }
  return 0
}

# ---------- Parse Arguments ----------
set dryrun 0
set fromStage ""
set toStage ""
for {set i 0} {$i < $argc} {incr i} {
  set a [lindex $argv $i]
  switch -- $a {
    "--dry-run"       { set dryrun 1 }
    "--from"          { incr i; set fromStage [lindex $argv $i] }
    "--to"            { incr i; set toStage   [lindex $argv $i] }
    "--password"      { incr i; set CURRENT_PASS [lindex $argv $i] }
    "--remove-docker" { set REMOVE_DOCKER 1 }
    "--keep-hostname" { set KEEP_HOSTNAME 1 }
    "--help" -
    "--usage"         { print_help; exit 0 }
    default           { }
  }
}

proc stage_index {name} {
  upvar STAGES STAGES
  set idx 0
  foreach s $STAGES { if {$s eq $name} { return $idx }; incr idx }
  return -1
}
set startIdx 0
set endIdx [expr {[llength $STAGES] - 1}]
if {$fromStage ne ""} {
  set i [stage_index $fromStage]
  if {$i < 0} { die "Unknown --from stage: $fromStage" }
  set startIdx $i
}
if {$toStage ne ""} {
  set j [stage_index $toStage]
  if {$j < 0} { die "Unknown --to stage: $toStage" }
  set endIdx $j
}

# ---------- Stage Implementations ----------

# T1: Locate every node — try the stored IP first, fall back to subnet scan
#     if the stored IP is stale (DHCP may have reassigned it).
#     State file is optional: if missing, scan-only mode is used.
proc stage_T1_load_state {dry stateRef} {
  upvar $stateRef state
  say "T1: Locating nodes (verify stored IPs; rescan on mismatch)"

  if {[file exists $::STATE_FILE]} {
    say "  State file found."
  } else {
    say "  No state file — will scan $::SUBNET to locate nodes by hostname."
  }

  if {$dry} {
    say "DRY: would prompt for current node password"
    say "DRY: for each node: try stored IP, fall back to nmap+hostname scan"
    return
  }

  if {$::CURRENT_PASS eq ""} {
    set ::CURRENT_PASS [ask_secret "Current node password (set during bootstrap): "]
  }
  if {$::CURRENT_PASS eq ""} {
    die "No password supplied — cannot SSH into nodes."
  }

  set located 0
  set lost {}
  for {set i 1} {$i <= $::NODE_COUNT} {incr i} {
    set name "${::NODE_PREFIX}$i"
    set stored [state_get $state $name ""]

    # Try stored IP first — avoids a full subnet scan when IPs are stable
    if {$stored ne "" && [node_at_ip $stored $name $::DEFAULT_USER $::CURRENT_PASS]} {
      say "  $name: confirmed at $stored"
      incr located
      continue
    }

    # Stored IP is stale or missing — scan the subnet and identify by hostname
    if {$stored ne ""} {
      say "  $name: $stored did not respond — scanning $::SUBNET…"
    } else {
      say "  $name: no stored IP — scanning $::SUBNET…"
    }
    set ip [find_node_ip $name $::SUBNET $::DEFAULT_USER $::CURRENT_PASS]
    if {$ip ne ""} {
      say "  $name: found at $ip (updating state)"
      dict set state $name $ip
      incr located
    } else {
      say "  WARNING: $name not found — may be powered off or have a different password."
      lappend lost $name
    }
  }

  if {$located == 0} {
    die "Could not locate any nodes. Check: nodes are powered on, password is correct, subnet is reachable."
  }
  if {[llength $lost] > 0} {
    say "  SSH stages will be skipped for: [join $lost {, }]"
  }
  say "T1: $located/$::NODE_COUNT nodes located."
}

# T2: Report the resolved IP for each node (T1 already verified them).
#     Any node T1 couldn't locate is flagged; subsequent stages skip it.
proc stage_T2_verify_connectivity {dry stateRef} {
  upvar $stateRef state
  say "T2: Node IP summary"
  for {set i 1} {$i <= $::NODE_COUNT} {incr i} {
    set name "${::NODE_PREFIX}$i"
    set ip [state_get $state $name ""]
    if {$ip eq ""} {
      say "  $name: NOT FOUND — SSH stages will be skipped"
    } else {
      say "  $name → $ip"
    }
  }
}

# T3: Stop and remove the registry container on the registry node.
#     With --remove-docker, also uninstall docker.io.
proc stage_T3_stop_registry {dry stateRef} {
  upvar $stateRef state
  set reg "${::NODE_PREFIX}$::REGISTRY_NODE_IDX"
  set ip [state_get $state $reg ""]
  say "T3: Stop registry on $reg ($ip)"
  if {$ip eq ""} { say "  No IP for $reg — skipping"; return }

  set cmds [list \
    "sudo docker stop registry 2>/dev/null || true" \
    "sudo docker rm   registry 2>/dev/null || true" \
  ]
  if {$::REMOVE_DOCKER} {
    lappend cmds "sudo apt-get purge -y docker.io docker-ce docker-ce-cli 2>/dev/null || true"
    lappend cmds "sudo apt-get autoremove -y 2>/dev/null || true"
  }

  if {$dry} {
    foreach c $cmds { say "DRY: on $reg: $c" }
    return
  }
  if {[ssh_shell $ip $::DEFAULT_USER $::CURRENT_PASS $cmds]} {
    say "  WARNING: some commands may have failed on $reg"
  } else {
    say "  registry stopped on $reg"
    if {$::REMOVE_DOCKER} { say "  docker removed from $reg" }
  }
}

# T4: Reset password on every node back to ubuntu:ubuntu.
#     After this stage the bootstrap script can SSH in with default credentials.
proc stage_T4_reset_passwords {dry stateRef} {
  upvar $stateRef state
  say "T4: Reset passwords to ubuntu:$::DEFAULT_PASS"
  for {set i 1} {$i <= $::NODE_COUNT} {incr i} {
    set name "${::NODE_PREFIX}$i"
    set ip [state_get $state $name ""]
    if {$ip eq ""} { say "  $name: IP unknown — skipping"; continue }
    set cmds [list \
      "echo '${::DEFAULT_USER}:${::DEFAULT_PASS}' | sudo chpasswd" \
    ]
    if {$dry} {
      say "DRY: on $name ($ip): ${cmds}"
      continue
    }
    if {[ssh_shell $ip $::DEFAULT_USER $::CURRENT_PASS $cmds]} {
      say "  WARNING: password reset may have failed on $name"
    } else {
      say "  $name ($ip): password reset to $::DEFAULT_PASS"
    }
  }
}

# T5: Reset hostnames back to ubuntu on every node.
#     Optional (--keep-hostname to skip) because Phase A5 overwrites this anyway.
#     Also removes the 127.0.1.1 rk1-nodeN entry from /etc/hosts on each node.
proc stage_T5_reset_hostnames {dry stateRef} {
  upvar $stateRef state
  if {$::KEEP_HOSTNAME} { say "T5: Skipping hostname reset (--keep-hostname)"; return }
  say "T5: Reset hostnames to ubuntu"
  for {set i 1} {$i <= $::NODE_COUNT} {incr i} {
    set name "${::NODE_PREFIX}$i"
    set ip [state_get $state $name ""]
    if {$ip eq ""} { say "  $name: IP unknown — skipping"; continue }
    # Use CURRENT_PASS if password reset (T4) didn't complete yet, otherwise DEFAULT_PASS.
    # We always run T5 after T4, so the password is now DEFAULT_PASS.
    # Guard: if run standalone (--from T5), we may still need CURRENT_PASS.
    set pass $::DEFAULT_PASS
    if {$::CURRENT_PASS ne ""} { set pass $::CURRENT_PASS }
    set cmds [list \
      "sudo hostnamectl set-hostname ubuntu" \
      {sudo sed -i "/\brk1-node[0-9]*\b/d" /etc/hosts} \
    ]
    if {$dry} {
      foreach c $cmds { say "DRY: on $name ($ip): $c" }
      continue
    }
    if {[ssh_shell $ip $::DEFAULT_USER $pass $cmds]} {
      say "  WARNING: hostname reset may have failed on $name"
    } else {
      say "  $name ($ip): hostname reset to ubuntu"
    }
  }
}

# T6: Remove rk1-nodeN entries from the laptop's /etc/hosts.
proc stage_T6_clean_laptop_hosts {dry stateRef} {
  upvar $stateRef state
  say "T6: Remove node entries from /etc/hosts"
  set names {}
  for {set i 1} {$i <= $::NODE_COUNT} {incr i} { lappend names "${::NODE_PREFIX}$i" }
  if {$dry} {
    say "DRY: would run: sudo bootstrap-host-helper.sh hosts-remove [join $names { }]"
    return
  }
  set flat [join $names " "]
  set rc [catch {sh "sudo [file dirname [info script]]/bootstrap-host-helper.sh hosts-remove $flat"} out]
  if {$rc} {
    say "WARNING: /etc/hosts cleanup failed: $out"
  } else {
    say "  /etc/hosts updated:\n$out"
  }
}

# T7: Gracefully power down nodes (SSH poweroff), then confirm via tpi.
#     tpi power off is a hard cut — SSH poweroff first gives the OS a chance to flush.
proc stage_T7_poweroff_nodes {dry stateRef} {
  upvar $stateRef state
  say "T7: Powering down nodes"

  # After T4 the password is DEFAULT_PASS.  If T4 was skipped, fall back to CURRENT_PASS.
  set pass $::DEFAULT_PASS
  if {$::CURRENT_PASS ne ""} { set pass $::CURRENT_PASS }

  for {set i 1} {$i <= $::NODE_COUNT} {incr i} {
    set name "${::NODE_PREFIX}$i"
    set ip [state_get $state $name ""]
    if {$ip eq ""} { say "  $name: IP unknown — skipping graceful shutdown"; continue }
    if {$dry} { say "DRY: ssh $name: sudo poweroff; wait for SSH to drop"; continue }
    say "  $name ($ip): graceful shutdown…"
    catch {ssh_shell $ip $::DEFAULT_USER $pass [list "sudo poweroff"]}
    # Wait for SSH to become unreachable — confirms the OS has actually shut down.
    # Each failed connection attempt takes ~ConnectTimeout s, providing natural pacing.
    if {[wait_for_ssh_gone $ip $::DEFAULT_USER 60]} {
      say "  $name: down"
    } else {
      say "  $name: still reachable after 60 s — BMC will cut power anyway"
    }
  }

  # BMC hard power-off — idempotent even if nodes already off
  set tpi_args [list tpi]
  if {$::BMC_HOST ne ""} { lappend tpi_args --host $::BMC_HOST }
  lappend tpi_args power off
  if {$dry} {
    say "DRY: [join $tpi_args { }]  (all nodes)"
  } else {
    say "  BMC: [join $tpi_args { }]"
    set rc [catch {exec {*}$tpi_args} out]
    if {$rc} { say "  WARNING: $out" } else { say "  $out" }
  }
}

# T8: Archive or delete the bootstrap state file.
#     Keeps a timestamped backup so IPs can be recovered if needed.
proc stage_T8_clear_state {dry stateRef} {
  upvar $stateRef state
  say "T8: Clear state file"
  if {![file exists $::STATE_FILE]} { say "  No state file found — nothing to clear."; return }
  set backup "${::STATE_FILE}.bak.[clock format [clock seconds] -format {%Y%m%d-%H%M%S}]"
  if {$dry} {
    say "DRY: would rename $::STATE_FILE → $backup"
    return
  }
  file rename -force $::STATE_FILE $backup
  say "  state archived to $backup"
  say "  Cluster is now in a clean state — ready for bootstrap rerun."
}

# ---------- Main ----------
if {$argc == 0} {
  puts "Tip: run './teardown-cluster.exp --help' for usage."
  puts "     run './teardown-cluster.exp --dry-run' to preview all teardown actions."
}

say "Starting teardown (dry-run=$dryrun, from=[expr {$fromStage eq {} ? {start} : $fromStage}], to=[expr {$toStage eq {} ? {end} : $toStage}])"
if {$REMOVE_DOCKER} { say "  --remove-docker: Docker will be uninstalled from registry node" }
if {$KEEP_HOSTNAME}  { say "  --keep-hostname: hostname reset skipped" }

set state [kv_load $STATE_FILE]
# Restore BMC_HOST from state so tpi commands work even if run non-interactively
if {$BMC_HOST eq "" && [dict exists $state "bmc_ip"]} {
  set BMC_HOST [dict get $state "bmc_ip"]
  say "Restored BMC host from state: $BMC_HOST"
}

for {set idx $startIdx} {$idx <= $endIdx} {incr idx} {
  set s [lindex $STAGES $idx]
  say "Stage $s"
  switch -- $s {
    "T1_load_state"         { stage_T1_load_state         $dryrun state }
    "T2_verify_connectivity" { stage_T2_verify_connectivity $dryrun state }
    "T3_stop_registry"      { stage_T3_stop_registry       $dryrun state }
    "T4_reset_passwords"    { stage_T4_reset_passwords     $dryrun state }
    "T5_reset_hostnames"    { stage_T5_reset_hostnames     $dryrun state }
    "T6_clean_laptop_hosts" { stage_T6_clean_laptop_hosts  $dryrun state }
    "T7_poweroff_nodes"     { stage_T7_poweroff_nodes      $dryrun state }
    "T8_clear_state"        { stage_T8_clear_state         $dryrun state }
    default { say "  (unimplemented stage placeholder)" }
  }
}
say "Teardown complete."
