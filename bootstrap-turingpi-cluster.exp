#!/usr/bin/expect -f

# TuringPi Bootstrap, with options to facilitate pause / resume of
# the various stages, and also providing a dryrun option to show
# what actions will be performed for wanted execution scope.
# Options include
#   --dry-run,
#   --from/--to,
#   --phase,
#   --flash, --image, --image-N,
#   --manifest, --cache-dir,
#   --bmc-firmware, --bmc-manifest, and
#   --help / --usage

# ---------- Defaults ----------
set SUBNET "192.168.1.0/24"
set NODE_COUNT 4
set NODE_PREFIX "rk1-node"
set DEFAULT_USER "ubuntu"
set DEFAULT_PASS "ubuntu"
set NEW_PASS ""                 ;# will prompt once if empty
set REGISTRY_NODE_IDX 1
set REGISTRY_PORT 5000
# Use a simple key=value state file
set STATE_FILE "./bootstrap-state.kv"
set _default_state_file $STATE_FILE
set FLASH_MODE "skip"           ;# image|download|local|bmc|skip
set IMAGE_DEFAULT ""            ;# image path for all nodes (image mode); overridden per-node via IMAGE_N
set IMAGE_PATHS [dict create]   ;# node index → image path overrides (set via --image-N or config IMAGE_N)
set IMAGE_DEFAULT_TYPE "default" ;# manifest image type for all nodes (download mode)
set IMAGE_NODE_TYPES [dict create] ;# node index → manifest type overrides (config IMAGE_N_TYPE)
set MANIFEST_FILE "./images-manifest.kv" ;# image manifest for download mode
set IMAGE_CACHE_DIR "./image-cache"      ;# local cache for downloaded images
set SERVER_NODE_IDX 1           ;# which node runs k3s server (Phase B reference; not used by flash itself)
set BMC_FIRMWARE_MODE "skip"    ;# skip|check|upgrade  (A0 stage)
set BMC_MANIFEST_FILE "./bmc-manifest.kv"  ;# version + download URL for BMC firmware
set BMC_HOST ""                 ;# set by A1 from nmap; passed as --host to tpi
set BMC_USER "root"             ;# SSH user on BMC (for --flash bmc)
set BMC_PASS ""                 ;# SSH password on BMC; leave blank for key/passwordless auth
set BMC_IMAGE_DIR "/mnt/sdcard/tpi-images"  ;# directory on BMC to store downloaded images
set BMC_SDCARD_DEV ""                        ;# SD card partition on BMC; blank = auto-detect largest ext2/3/4 mmcblk partition

# ---------- Stage Registry ----------
set STAGES {
  A0_bmc_firmware
  A1_find_bmc
  A2_poweroff_all
  A3_flash_optional
  A4_power_on_and_discover
  A5_name_password_reboot
  A6_write_hosts_on_laptop
  A7_ephemeral_registry_phaseA
}

# ---------- utils ----------
proc say {msg} { puts "\n==> $msg" }
proc elapsed {secs} {
  set h [expr {$secs / 3600}]
  set m [expr {($secs % 3600) / 60}]
  set s [expr {$secs % 60}]
  if {$h > 0} { return "${h}h ${m}m ${s}s" }
  if {$m > 0} { return "${m}m ${s}s" }
  return "${s}s"
}
proc sh {cmd} { set f [open [list | bash -c $cmd 2>@1] r]; set out [read $f]; catch {close $f}; return $out }
proc ask_secret {prompt} {
  catch {stty -echo}
  send_user $prompt
  set val ""
  expect_user {
    -timeout -1
    -re "(.*)\n" { catch { set val [string trimright $expect_out(1,string) "\r"] } }
  }
  catch {stty echo}
  send_user "\n"
  return $val
}
proc die {msg} { puts stderr "ERROR: $msg"; exit 1 }

proc print_help {} {
  upvar STAGES STAGES
  puts "Turing Pi RK1 Bootstrap (resumable)\n"
  puts "Usage:"
  puts "  ./bootstrap-turingpi-cluster.exp \[--config FILE\] \[--dry-run\] \[--phase A|B|C\]"
  puts "    \[--from STAGE\] \[--to STAGE\] \[--flash image|download|local|skip\]"
  puts "    \[--image PATH\] \[--image-1 PATH\] ... \[--image-4 PATH\]"
  puts "    \[--bmc-firmware check|upgrade|skip\] \[--bmc-manifest FILE\]"
  puts ""
  puts "Options:"
  puts "  --config FILE       Load key=value config (repeatable; last value wins)."
  puts "                      Auto-loaded from ./bootstrap-config.kv if present and no --config given."
  puts "  --dry-run           Print actions without making changes"
  puts "  --rediscover        Scan subnet, identify nodes by hostname, update state + /etc/hosts"
  puts "  --phase A|B|C       Shortcut to a stage range (Phase A implemented here)"
  puts "  --from STAGE        Start at a specific stage"
  puts "  --to STAGE          Stop after a specific stage"
  puts "  --flash image|download|local|bmc|skip"
  puts "                      image:    upload a local image file via tpi flash --image-path"
  puts "                      download: fetch image(s) from manifest, verify SHA256, then flash"
  puts "                      local:    use image already on BMC SD card (tpi flash --local)"
  puts "                      bmc:      SSH to BMC, curl image to SD card there, then flash"
  puts "                                (avoids uploading from laptop; SD card must be present)"
  puts "                      skip:     skip flashing entirely (default)"
  puts "  --image PATH        Default OS image file for all nodes (--flash image)"
  puts "  --image-N PATH      Per-node image override for node N (1-4); overrides --image."
  puts "                      Example: --image worker.img --image-1 server.img"
  puts "  --manifest FILE     Image manifest for node download mode (default: ./images-manifest.kv)"
  puts "  --cache-dir DIR     Directory for cached downloads (default: ./image-cache)"
  puts "  --bmc-firmware check|upgrade|skip"
  puts "                      check:   report BMC version and warn if outdated (A0 stage)"
  puts "                      upgrade: download + verify SHA256 + flash if outdated"
  puts "                      skip:    skip BMC firmware check entirely (default)"
  puts "  --bmc-manifest FILE BMC firmware manifest (default: ./bmc-manifest.kv)"
  puts "                      Copy bmc-manifest.kv.example to get started."
  puts "  --help, --usage     Show this help"
  puts ""
  puts "Config file keys (bootstrap-config.kv):"
  puts "  SUBNET, NODE_COUNT, NODE_PREFIX, DEFAULT_USER, DEFAULT_PASS, NEW_PASS"
  puts "  REGISTRY_NODE_IDX, REGISTRY_PORT, STATE_FILE"
  puts "  FLASH_MODE, IMAGE_DEFAULT, IMAGE_1..IMAGE_4"
  puts "  IMAGE_DEFAULT_TYPE, IMAGE_1_TYPE..IMAGE_4_TYPE  (manifest type per node, download mode)"
  puts "  MANIFEST_FILE, IMAGE_CACHE_DIR"
  puts "  BMC_FIRMWARE_MODE, BMC_MANIFEST_FILE"
  puts "  SERVER_NODE_IDX, BMC_HOST"
  puts "  BMC_USER, BMC_PASS, BMC_IMAGE_DIR, BMC_SDCARD_DEV  (bmc flash mode)"
  puts ""
  puts "Stages:"
  foreach s $STAGES { puts "  - $s" }
  puts ""
  puts "State file: bootstrap-state.kv (auto-saved after each stage)"
}

# Load key=value file into a dict
proc kv_load {file} {
  set m [dict create]
  if {[file exists $file]} {
    set f [open $file r]
    while {[gets $f line] >= 0} {
      set line [string trim $line]
      if {$line eq ""} continue
      if {[string match "#*" $line]} continue
      if {[regexp {^([^=]+)=(.*)$} $line -> k v]} {
        dict set m [string trim $k] [string trim $v]
      }
    }
    close $f
  }
  return $m
}

# Save dict back to key=value file
proc kv_save {file m} {
  set f [open $file w]
  # sort keys for stability
  foreach k [lsort [dict keys $m]] {
    set v [dict get $m $k]
    puts $f "$k=$v"
  }
  close $f
}

# Get with default
proc state_get {m key default} {
  if {[dict exists $m $key]} {
    return [dict get $m $key]
  } else {
    return $default
  }
}

# Put (mutates the dict via upvar)
proc state_put {mVar key val} {
  upvar $mVar m
  dict set m $key $val
}

# Apply a kv dict (from a config file) to the script's global config variables.
# Called for each --config file before flag overrides are applied.
proc apply_config {cfg} {
  foreach key {SUBNET NODE_COUNT NODE_PREFIX DEFAULT_USER DEFAULT_PASS NEW_PASS
               REGISTRY_NODE_IDX REGISTRY_PORT STATE_FILE FLASH_MODE IMAGE_DEFAULT
               IMAGE_DEFAULT_TYPE MANIFEST_FILE IMAGE_CACHE_DIR
               BMC_FIRMWARE_MODE BMC_MANIFEST_FILE
               SERVER_NODE_IDX BMC_HOST
               BMC_USER BMC_PASS BMC_IMAGE_DIR BMC_SDCARD_DEV} {
    if {[dict exists $cfg $key]} { set ::$key [dict get $cfg $key] }
  }
  dict for {k v} $cfg {
    if {[regexp {^IMAGE_(\d+)$}      $k -> idx]} { dict set ::IMAGE_PATHS      $idx $v }
    if {[regexp {^IMAGE_(\d+)_TYPE$} $k -> idx]} { dict set ::IMAGE_NODE_TYPES $idx $v }
  }
}

# SSH helpers
proc ssh_ok {ip user pass cmd} {
  spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
            -o ConnectTimeout=3 -o BatchMode=no $user@$ip $cmd
  expect {
    -re "(P|p)assword:" { send "$pass\r"; exp_continue }
    -re "Are you sure.*" { send "yes\r"; exp_continue }
    timeout { catch {close}; return 1 }
    eof {}
  }
  return 0
}

# Poll until a host not in $baseline appears on $subnet with SSH open and accepting $user/$pass.
# Returns the IP as soon as it's found; returns "" if $deadline_s elapses.
# No explicit sleep — each nmap scan takes a few seconds and provides natural pacing.
proc wait_for_new_ssh_host {baseline subnet user pass deadline_s} {
  set deadline [expr {[clock seconds] + $deadline_s}]
  while {[clock seconds] < $deadline} {
    set current [discover_nodes $subnet]
    foreach cand $current {
      if {[lsearch -exact $baseline $cand] >= 0} continue
      if {[ssh_ok $cand $user $pass "echo ok"] == 0} { return $cand }
    }
  }
  return ""
}

# Poll until SSH on $ip is unreachable (node has shut down).
# Returns 1 if node went away within $deadline_s, 0 if it didn't.
proc wait_for_ssh_gone {ip user deadline_s} {
  set deadline [expr {[clock seconds] + $deadline_s}]
  while {[clock seconds] < $deadline} {
    set rc [catch {exec ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                            -o ConnectTimeout=2 -o BatchMode=yes \
                            $user@$ip echo ping 2>/dev/null} out]
    if {$rc} { return 1 }
  }
  return 0
}
proc ssh_shell {ip user pass commands} {
  spawn ssh -tt -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null $user@$ip
  expect {
    -re "(P|p)assword:" { send "$pass\r"; exp_continue }
    -re "Are you sure.*" { send "yes\r"; exp_continue }
    -re "\\$ " { }
    eof     { return 1 }
    timeout { return 1 }
  }
  foreach c $commands {
    send -- "$c\r"
    expect {
      -re "(?i)password for $user:" { send -- "$pass\r"; exp_continue }
      -re "\\$ " { }
      eof     { return 1 }
      timeout { return 1 }
    }
  }
  send -- "exit\r"; expect eof; return 0
}

# Checks
proc check_bmc_known {state} { set ip [state_get $state "bmc_ip" ""]; return [expr {$ip ne ""}] }
proc check_node_named {ip nodename user pass} {
  set found ""
  spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
            -o ConnectTimeout=3 -o BatchMode=no $user@$ip hostname
  expect {
    -re "(P|p)assword:" { send "$pass\r"; exp_continue }
    -re "Are you sure.*" { send "yes\r"; exp_continue }
    -re {([^\r\n]+)\r?\n} { set found [string trim $expect_out(1,string)]; exp_continue }
    timeout { catch {close} }
    eof {}
  }
  return [expr {$found eq $nodename}]
}
proc check_hosts_contains {name ip} {
  set out [sh "grep -E \"\\b$name\\b\" /etc/hosts || true"]
  return [expr {[string first $ip $out] >= 0}]
}
proc check_registry_http_up {ip port} {
  set out [sh "curl -sS http://$ip:$port/v2/_catalog || true"]
  return [expr {[string match *repositories* $out]}]
}

# Power control via tpi CLI (installed on operator's laptop, talks to BMC)
# node: integer 1-N, or the string "all"
# action: "on" | "off"
# Uses $::BMC_HOST if set, so mDNS failures don't stall the script.
proc tpi_power {node action} {
  set cmd "tpi power $action"
  if {$node ne "all"} { append cmd " -n $node" }
  say "  BMC: $cmd"
  lassign [bmc_cmd $cmd] rc out
  if {$rc} { say "  WARNING: tpi power $action → $out"; return 1 }
  if {[string trim $out] ne ""} { say "  $out" }
  return 0
}

proc tpi_status {} {
  lassign [bmc_cmd "tpi power status"] rc out
  if {$rc} { return "unknown ($out)" }
  return $out
}

# Query BMC firmware version via tpi info.
# Returns the version string (e.g. "2.3.2") or dies on failure.
proc bmc_firmware_version {} {
  lassign [bmc_cmd "tpi info"] rc out
  if {$rc} { die "Cannot query BMC info: $out" }
  if {[regexp { version\s*:\s*(\S+)} $out -> ver]} { return [string trim $ver] }
  die "Could not parse BMC firmware version from tpi info output:\n$out"
}

# Return the image path to use for a given node index.
# Per-node IMAGE_PATHS overrides IMAGE_DEFAULT.
proc flash_image_for {node_idx} {
  if {[dict exists $::IMAGE_PATHS $node_idx]} { return [dict get $::IMAGE_PATHS $node_idx] }
  return $::IMAGE_DEFAULT
}

# Flash a single node via tpi CLI, streaming output to the terminal.
# img_or_local: a file path (image mode) or the literal string "local"
# Timeout is generous — uploading a full OS image over USB can take 10–20 minutes.
proc tpi_flash_node {node_idx img_or_local} {
  set cmd [list tpi]
  if {$::BMC_HOST ne ""} { lappend cmd --host $::BMC_HOST }
  lappend cmd flash -n $node_idx
  if {$img_or_local eq "local"} {
    lappend cmd --local
  } else {
    lappend cmd --image-path $img_or_local
  }
  say "  spawn: [join $cmd { }]"
  set timeout 1800
  set output ""
  spawn {*}$cmd
  expect {
    -re "Error occured.*" { append output $expect_out(0,string); exp_continue }
    eof {}
  }
  lassign [wait] pid spawnid os_err exit_code
  # tpi 1.0.x exits 0 even on flash errors — check output as a fallback
  if {$exit_code != 0 || [string match "*Error occured*" $output]} {
    die "tpi flash node $node_idx failed: [string trim $output]"
  }
}

# Run a short command on the BMC via SSH. Returns {exit_code output}.
proc bmc_cmd {cmd {timeout_s 30}} {
  set bmc $::BMC_HOST
  if {$bmc eq ""} { die "BMC host not known. Run A1 first or set BMC_HOST in config." }
  set output ""
  spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
            -o ConnectTimeout=5 -o BatchMode=no $::BMC_USER@$bmc $cmd
  set timeout $timeout_s
  expect {
    -re "(P|p)assword:" {
      if {$::BMC_PASS ne ""} { send "$::BMC_PASS\r"; exp_continue } \
      else { send "\r"; exp_continue }
    }
    -re {[^\r\n]*\r?\n} { append output $expect_out(0,string); exp_continue }
    timeout {}
    eof {}
  }
  lassign [wait] pid spawnid os_err exit_code
  return [list $exit_code [string trim $output]]
}

# Run a long-running command on the BMC (e.g. curl download), streaming output to terminal.
# Returns the exit code. timeout_s should be generous (3600 for large image downloads).
proc bmc_stream {cmd timeout_s} {
  set bmc $::BMC_HOST
  if {$bmc eq ""} { die "BMC host not known. Run A1 first or set BMC_HOST in config." }
  set output ""
  spawn ssh -tt -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
            -o ConnectTimeout=5 -o BatchMode=no $::BMC_USER@$bmc $cmd
  log_user 0
  set timeout $timeout_s
  expect {
    -re "(P|p)assword:" {
      if {$::BMC_PASS ne ""} { send "$::BMC_PASS\r"; exp_continue } \
      else { send "\r"; exp_continue }
    }
    -re {.+} {
      set chunk $expect_out(0,string)
      append output $chunk
      puts -nonewline $chunk
      flush stdout
      exp_continue
    }
    timeout { log_user 1; die "BMC command timed out after ${timeout_s}s: $cmd" }
    eof {}
  }
  log_user 1
  lassign [wait] pid spawnid os_err exit_code
  return [list $exit_code $output]
}

# Flash a single node via tpi using an image path on the BMC's own filesystem.
proc tpi_flash_node_bmc {node_idx bmc_path} {
  # Run tpi directly on the BMC — no --host or credentials needed when running locally on the BMC
  say "  BMC: tpi flash -n $node_idx --local --image-path $bmc_path"
  lassign [bmc_stream "tpi flash -n $node_idx --local --image-path [list $bmc_path]" 1800] rc output
  if {$rc != 0 || [string match "*Error occured*" $output]} {
    die "tpi flash node $node_idx (bmc) failed: [string trim $output]"
  }
}

# Return the manifest image type for a given node (download mode).
proc image_type_for {node_idx} {
  if {[dict exists $::IMAGE_NODE_TYPES $node_idx]} { return [dict get $::IMAGE_NODE_TYPES $node_idx] }
  return $::IMAGE_DEFAULT_TYPE
}

# Parse images-manifest.kv into a nested dict: type → {url ... sha256 ... description ...}
# Format: TYPE.url=..., TYPE.sha256=..., TYPE.description=...
proc load_manifest {file} {
  if {![file exists $file]} { die "Manifest file not found: $file\nCopy images-manifest.kv.example to $file and fill in URLs + SHA256 checksums." }
  set raw [kv_load $file]
  set manifest [dict create]
  dict for {k v} $raw {
    if {[regexp {^([^.]+)\.(.+)$} $k -> type field]} {
      if {![dict exists $manifest $type]} { dict set manifest $type [dict create] }
      dict set manifest $type $field $v
    }
  }
  return $manifest
}

# Return the SHA256 hex digest of a local file using sha256sum.
proc sha256_file {path} {
  return [string trim [lindex [split [sh "sha256sum [list $path]"] " "] 0]]
}

# Verify a local image file against its .sha256 sidecar if one exists.
# Dies on mismatch; warns and continues if the sidecar is absent.
proc verify_image_sidecar {path} {
  set sidecar "${path}.sha256"
  if {![file exists $sidecar]} {
    say "  WARNING: no .sha256 sidecar for [file tail $path] — skipping verification"
    return
  }
  set expected [string trim [lindex [split [read [open $sidecar r]] " \t\n"] 0]]
  say "  Verifying SHA256 of [file tail $path]…"
  set actual [sha256_file $path]
  if {$actual ne $expected} {
    die "SHA256 mismatch for [file tail $path]\n  got:      $actual\n  expected: $expected"
  }
  say "  SHA256 OK"
}

# Ensure the image for $type is present in the cache and its SHA256 matches the manifest.
# Downloads and verifies if missing or corrupted. Returns the local file path.
proc ensure_image_cached {type manifest} {
  if {![dict exists $manifest $type]} {
    die "Unknown image type '$type'. Available in manifest: [join [dict keys $manifest] {, }]"
  }
  set entry [dict get $manifest $type]
  foreach req {url sha256} {
    if {![dict exists $entry $req]} { die "Manifest entry '$type' is missing the '$req' field" }
  }
  set url      [dict get $entry url]
  set expected [string tolower [string trim [dict get $entry sha256]]]
  set fname    [file tail $url]
  set cache    [file join $::IMAGE_CACHE_DIR $fname]

  if {[file exists $cache]} {
    say "  Cache hit: $cache"
    say "  Verifying SHA256…"
    set actual [sha256_file $cache]
    if {$actual eq $expected} {
      say "  SHA256 OK"
      return $cache
    }
    say "  SHA256 mismatch — re-downloading (cached: $actual, expected: $expected)"
    file delete $cache
  }

  file mkdir $::IMAGE_CACHE_DIR
  say "  Downloading: $url"
  # curl -L follows redirects; --fail exits non-zero on HTTP errors
  set rc [catch {exec curl -L --fail --progress-bar -o $cache $url 2>@stdout} out]
  if {$rc} {
    catch {file delete $cache}
    die "Download failed for '$type': $out"
  }

  say "  Verifying SHA256…"
  set actual [sha256_file $cache]
  if {$actual ne $expected} {
    file delete $cache
    die "SHA256 mismatch after download for '$type' — file deleted.\n  got:      $actual\n  expected: $expected\nThis may indicate a corrupted download or a MitM attack. Do not proceed."
  }
  say "  SHA256 OK"
  return $cache
}

# Discovery helpers
proc find_bmc {subnet} {
  say "Scanning $subnet for BMC (hostname likely 'turingpi')"
  set out [sh "nmap -sn $subnet | grep -B1 'turingpi' | head -n1"]
  if {$out eq ""} { return "" }
  set ip ""
  foreach line [split $out "\n"] {
    if {[regexp {Nmap scan report for .* \(([\d\.]+)\)} $line -> ipaddr]} { set ip $ipaddr } \
    elseif {[regexp {Nmap scan report for ([\d\.]+)} $line -> ip2]} { set ip $ip2 }
  }
  return $ip
}
proc discover_nodes {subnet} {
  set ips {}
  set out [sh "nmap -sn $subnet | grep 'Nmap scan report for'"]
  foreach line [split $out "\n"] {
    if {[regexp {Nmap scan report for \S+ \(([\d\.]+)\)} $line -> ip]} { lappend ips $ip } \
    elseif {[regexp {Nmap scan report for ([\d\.]+)} $line -> ip]} { lappend ips $ip }
  }
  set good {}
  foreach ip $ips {
    set chk [sh "timeout 1 bash -lc 'echo >/dev/tcp/$ip/22' && echo ok || echo no"]
    if {[string match *ok* $chk]} { lappend good $ip }
  }
  return $good
}

# ---------- Parse Arguments ----------
# Pass 1: load config files (so flags in pass 2 can override them)
set _config_files {}
for {set i 0} {$i < $argc} {incr i} {
  set a [lindex $argv $i]
  if {$a eq "--help" || $a eq "--usage"} { print_help; exit 0 }
  if {$a eq "--config"} { incr i; lappend _config_files [lindex $argv $i] }
}
# Auto-load ./bootstrap-config.kv when no --config was given.
# Set BOOTSTRAP_NO_AUTO_CONFIG=1 in the environment to suppress (used by CI tests).
if {[llength $_config_files] == 0 && [file exists "./bootstrap-config.kv"] \
    && ![info exists ::env(BOOTSTRAP_NO_AUTO_CONFIG)]} {
  lappend _config_files "./bootstrap-config.kv"
}
foreach _cf $_config_files {
  if {![file exists $_cf]} { die "Config file not found: $_cf" }
  apply_config [kv_load $_cf]
  say "Loaded config: $_cf"
}
unset _config_files

# Pass 2: flag overrides (take precedence over config file values)
set dryrun 0
set fromStage ""
set toStage ""
set phase ""
set rediscover 0
for {set i 0} {$i < $argc} {incr i} {
  set a [lindex $argv $i]
  switch -- $a {
    "--dry-run"    { set dryrun 1 }
    "--from"       { incr i; set fromStage [lindex $argv $i] }
    "--to"         { incr i; set toStage   [lindex $argv $i] }
    "--phase"      { incr i; set phase     [lindex $argv $i] }
    "--flash"      { incr i; set FLASH_MODE      [lindex $argv $i] }
    "--image"      { incr i; set IMAGE_DEFAULT  [lindex $argv $i] }
    "--image-1"    { incr i; dict set IMAGE_PATHS 1 [lindex $argv $i] }
    "--image-2"    { incr i; dict set IMAGE_PATHS 2 [lindex $argv $i] }
    "--image-3"    { incr i; dict set IMAGE_PATHS 3 [lindex $argv $i] }
    "--image-4"    { incr i; dict set IMAGE_PATHS 4 [lindex $argv $i] }
    "--manifest"      { incr i; set MANIFEST_FILE      [lindex $argv $i] }
    "--cache-dir"     { incr i; set IMAGE_CACHE_DIR    [lindex $argv $i] }
    "--bmc-firmware"  { incr i; set BMC_FIRMWARE_MODE  [lindex $argv $i] }
    "--bmc-manifest"  { incr i; set BMC_MANIFEST_FILE  [lindex $argv $i] }
    "--rediscover"    { set rediscover 1 }
    "--config"     { incr i }
    "--help" -
    "--usage"      { }
    default        { }
  }
}

# phase shortcuts
if {$phase ne ""} {
  switch -- $phase {
    "A" { set fromStage "A0_bmc_firmware"; set toStage "A7_ephemeral_registry_phaseA" }
    "B" { set fromStage "B1_persistent_storage"; set toStage "B8_verify_https_auth" }
    "C" { set fromStage "C1_local_registry_mirror"; set toStage "C3_sync_resilience" }
    default { }
  }
}

# Helpers to slice stages
proc stage_index {name} {
  upvar STAGES STAGES
  set idx 0
  foreach s $STAGES { if {$s eq $name} { return $idx } ; incr idx }
  return -1
}
set startIdx 0
set endIdx [expr {[llength $STAGES]-1}]
if {$fromStage ne ""} { set i [stage_index $fromStage]; if {$i < 0} { die "Unknown --from $fromStage" } ; set startIdx $i }
if {$toStage ne ""}   { set j [stage_index $toStage];   if {$j < 0} { die "Unknown --to $toStage" }   ; set endIdx $j }

# ---------- Stage Implementations ----------
# ----- Stage  A0 -------
proc stage_A0_bmc_firmware {dry stateRef} {
  upvar $stateRef state
  say "A0: BMC firmware mode: $::BMC_FIRMWARE_MODE"
  if {$::BMC_FIRMWARE_MODE eq "skip"} { say "Skipping BMC firmware check (use --bmc-firmware check|upgrade to enable)"; return }

  if {$dry} {
    say "DRY: tpi info → check version against $::BMC_MANIFEST_FILE"
    if {$::BMC_FIRMWARE_MODE eq "upgrade"} {
      say "DRY: if outdated: download + verify SHA256 + tpi firmware --file <image>"
    }
    return
  }

  # Resolve BMC_HOST from state if not already set
  if {$::BMC_HOST eq ""} {
    set stored [state_get $state "bmc_ip" ""]
    if {$stored ne ""} { set ::BMC_HOST $stored; say "  BMC host from state: $::BMC_HOST" } \
    else { die "BMC_HOST not set and not in state. Run A1 first or set BMC_HOST in config." }
  }

  say "  Querying BMC firmware version…"
  set current [bmc_firmware_version]
  say "  Running: $current"

  set manifest [load_manifest $::BMC_MANIFEST_FILE]
  if {![dict exists $manifest "latest"]} {
    die "BMC manifest '$::BMC_MANIFEST_FILE' must contain a 'latest' entry (latest.version, latest.url, latest.sha256)"
  }
  set entry [dict get $manifest "latest"]
  if {![dict exists $entry "version"]} { die "BMC manifest 'latest' entry is missing 'version' field" }
  set latest [dict get $entry "version"]
  say "  Latest known: $latest"

  if {$current eq $latest} {
    say "  BMC firmware is up to date."
    return
  }

  say "  BMC firmware outdated: $current → $latest"
  if {$::BMC_FIRMWARE_MODE eq "check"} {
    say "  WARNING: run with --bmc-firmware upgrade (or BMC_FIRMWARE_MODE=upgrade) to apply."
    return
  }

  # upgrade: download, verify, flash
  say "  Downloading BMC firmware $latest…"
  set fw_path [ensure_image_cached "latest" $manifest]

  say "  Flashing BMC firmware — the BMC will reboot (nodes will lose power briefly)…"
  set cmd [list tpi]
  if {$::BMC_HOST ne ""} { lappend cmd --host $::BMC_HOST }
  lappend cmd firmware --file $fw_path
  say "  spawn: [join $cmd { }]"
  set timeout 300
  spawn {*}$cmd
  expect eof
  lassign [wait] pid spawnid os_err exit_code
  if {$exit_code != 0} { die "BMC firmware flash failed (exit $exit_code)" }

  # Wait for BMC to go down then come back up
  say "  Waiting for BMC to reboot (up to 120 s)…"
  set deadline [expr {[clock seconds] + 120}]
  after 5000
  while {[clock seconds] < $deadline} {
    lassign [bmc_cmd "tpi info" 10] rc out
    if {!$rc} { break }
    after 3000
  }

  set new_ver [bmc_firmware_version]
  if {$new_ver eq $latest} {
    say "  BMC upgraded: $current → $new_ver"
    state_put state "bmc_firmware" $new_ver
  } else {
    say "  WARNING: version after upgrade is '$new_ver' (expected '$latest') — check manually"
  }
}

# ----- Stage  A1 -------
proc stage_A1_find_bmc {dry stateRef} {
  upvar $stateRef state
  if {$::BMC_HOST ne "" || [check_bmc_known $state]} {
    if {$::BMC_HOST eq ""} { set ::BMC_HOST [state_get $state "bmc_ip" ""] }
    state_put state "bmc_ip" $::BMC_HOST
    say "A1: BMC already known at $::BMC_HOST"
    return
  }
  say "A1: Discovering BMC via nmap…"
  if {$dry} { say "DRY: would run nmap on $::SUBNET"; return }
  set bmc [find_bmc $::SUBNET]
  if {$bmc eq ""} {
    say "Could not auto-detect BMC. Enter IP:"
    expect_user -re "(.*)\n"
    set bmc $expect_out(1,string)
  }
  state_put state "bmc_ip" $bmc
  set ::BMC_HOST $bmc
  set bmc_mac [string trim [sh "ip neigh show $bmc 2>/dev/null | grep -oE '([0-9a-f]{2}:)\{5\}[0-9a-f]\{2\}'"]]
  if {$bmc_mac ne ""} { state_put state "bmc_mac" $bmc_mac }
  say "BMC: $bmc  (MAC $bmc_mac)"
  # Pin turingpi.local in /etc/hosts so tpi works even when mDNS fails.
  set rc [catch {sh "sudo [file dirname [info script]]/bootstrap-host-helper.sh hosts-append $bmc turingpi.local"} out]
  if {$rc} { say "  WARNING: could not update /etc/hosts for BMC: $out" } else { say "  /etc/hosts: $bmc turingpi.local" }
}

# ----- Stage  A2 -------
proc stage_A2_poweroff_all {dry stateRef} {
  say "A2: Powering OFF all nodes via BMC"
  if {$dry} { say "DRY: tpi power off  (all nodes at once)"; return }
  tpi_power "all" "off"
  say "A2: All nodes powered off."
}

# ----- Stage  A3 -------
proc stage_A3_flash_optional {dry stateRef} {
  say "A3: Flash mode: $::FLASH_MODE"

  switch -- $::FLASH_MODE {

    "skip" {
      say "Skipping flash (use --flash image|download|local to enable)"
    }

    "local" {
      if {$dry} {
        for {set i 1} {$i <= $::NODE_COUNT} {incr i} { say "DRY: tpi flash -n $i --local" }
        return
      }
      say "Flashing $::NODE_COUNT nodes from BMC-local image…"
      for {set i 1} {$i <= $::NODE_COUNT} {incr i} {
        say "  Node $i of $::NODE_COUNT…"
        set _tn [clock seconds]
        tpi_flash_node $i "local"
        say "  Node $i: done. ([elapsed [expr {[clock seconds] - $_tn}]])"
      }
      say "A3: All nodes flashed."
    }

    "image" {
      # Validate all paths up front — fail before touching any hardware
      for {set i 1} {$i <= $::NODE_COUNT} {incr i} {
        set img [flash_image_for $i]
        if {$img eq ""} { die "No image for node $i. Set IMAGE_DEFAULT in config or --image PATH (--image-$i for per-node override)" }
        if {!$dry && ![file exists $img]} { die "Image for node $i not found: $img" }
      }
      if {$dry} {
        for {set i 1} {$i <= $::NODE_COUNT} {incr i} {
          set img [flash_image_for $i]
          set sidecar_note [expr {[file exists "${img}.sha256"] ? " (SHA256 sidecar present)" : " (no .sha256 sidecar)"}]
          say "DRY: tpi flash -n $i --image-path $img$sidecar_note"
        }
        return
      }
      # Verify SHA256 of every distinct image before touching any node
      set seen_imgs [dict create]
      for {set i 1} {$i <= $::NODE_COUNT} {incr i} {
        set img [flash_image_for $i]
        if {![dict exists $seen_imgs $img]} {
          verify_image_sidecar $img
          dict set seen_imgs $img 1
        }
      }
      say "Flashing $::NODE_COUNT nodes (this may take several minutes per node)…"
      for {set i 1} {$i <= $::NODE_COUNT} {incr i} {
        say "  Node $i of $::NODE_COUNT…"
        set _tn [clock seconds]
        tpi_flash_node $i [flash_image_for $i]
        say "  Node $i: done. ([elapsed [expr {[clock seconds] - $_tn}]])"
      }
      say "A3: All nodes flashed."
    }

    "download" {
      set manifest [load_manifest $::MANIFEST_FILE]
      if {$dry} {
        for {set i 1} {$i <= $::NODE_COUNT} {incr i} {
          set type [image_type_for $i]
          if {![dict exists $manifest $type]} {
            die "Unknown image type '$type' for node $i. Available: [join [dict keys $manifest] {, }]"
          }
          set url   [dict get $manifest $type url]
          set fname [file tail $url]
          set cache [file join $::IMAGE_CACHE_DIR $fname]
          if {[file exists $cache]} {
            say "DRY: node $i (type=$type): cache hit $cache — would verify SHA256 then flash"
          } else {
            say "DRY: node $i (type=$type): would download $url → $cache, verify SHA256, then flash"
          }
        }
        return
      }
      # Download and verify all distinct types first, then flash
      say "Downloading and verifying images…"
      set type_to_path [dict create]
      for {set i 1} {$i <= $::NODE_COUNT} {incr i} {
        set type [image_type_for $i]
        if {![dict exists $type_to_path $type]} {
          say "  Fetching type '$type'…"
          dict set type_to_path $type [ensure_image_cached $type $manifest]
        }
      }
      say "Flashing $::NODE_COUNT nodes (this may take several minutes per node)…"
      for {set i 1} {$i <= $::NODE_COUNT} {incr i} {
        set type [image_type_for $i]
        set path [dict get $type_to_path $type]
        say "  Node $i of $::NODE_COUNT (type=$type)…"
        set _tn [clock seconds]
        tpi_flash_node $i $path
        say "  Node $i: done. ([elapsed [expr {[clock seconds] - $_tn}]])"
      }
      say "A3: All nodes flashed."
    }

    "bmc" {
      # Download images directly on BMC via curl (HTTPS), cache on SD card, flash with --local.
      # Avoids uploading large files from the laptop over the network.
      set manifest [load_manifest $::MANIFEST_FILE]
      if {$dry} {
        set bmc_disp [expr {$::BMC_HOST ne "" ? $::BMC_HOST : "<bmc-host>"}]
        set sdcard_mount [file dirname $::BMC_IMAGE_DIR]
        if {$::BMC_SDCARD_DEV ne ""} {
          say "DRY: SSH $::BMC_USER@$bmc_disp: ensure $::BMC_SDCARD_DEV mounted at $sdcard_mount"
        } else {
          say "DRY: SSH $::BMC_USER@$bmc_disp: check $sdcard_mount; if not mounted, auto-detect largest ext2/3/4 mmcblk partition and mount"
        }
        say "DRY: SSH $::BMC_USER@$bmc_disp: mkdir -p $::BMC_IMAGE_DIR"
        for {set i 1} {$i <= $::NODE_COUNT} {incr i} {
          set type [image_type_for $i]
          if {![dict exists $manifest $type]} {
            die "Unknown image type '$type' for node $i. Available: [join [dict keys $manifest] {, }]"
          }
          set url      [dict get $manifest $type url]
          set fname    [file tail $url]
          set dest_dl  "$::BMC_IMAGE_DIR/$fname"
          set dest_img [expr {[string match "*.xz" $fname] ? [file rootname $dest_dl] : $dest_dl}]
          if {[string match "*.xz" $fname]} {
            say "DRY: node $i (type=$type): BMC curl/cache → $dest_dl, SHA256 verify, xzcat → $dest_img, tpi flash -n $i --local --image-path $dest_img"
          } else {
            say "DRY: node $i (type=$type): BMC curl/cache → $dest_dl, SHA256 verify, tpi flash -n $i --local --image-path $dest_dl"
          }
        }
        return
      }

      if {$::BMC_HOST eq ""} { die "BMC host not known. Run A1 first." }

      # Verify SSH connectivity to BMC before attempting any operations
      lassign [bmc_cmd "echo ok"] _rc _out
      if {$_rc != 0 || ![string match "*ok*" $_out]} {
        die "Cannot connect to BMC at $::BMC_HOST as $::BMC_USER via SSH.\nIf the BMC requires a password, set BMC_PASS in bootstrap-config.kv.\nIf using key-based auth, ensure your SSH key is authorized on the BMC."
      }

      # Ensure SD card is mounted at the parent of BMC_IMAGE_DIR
      set sdcard_mount [file dirname $::BMC_IMAGE_DIR]
      say "  Checking BMC SD card mount at $sdcard_mount…"
      lassign [bmc_cmd "mountpoint -q $sdcard_mount 2>/dev/null && echo yes || echo no"] _rc mnt_out
      if {![string match "*yes*" $mnt_out]} {
        set dev $::BMC_SDCARD_DEV
        if {$dev eq ""} {
          say "  Not mounted — auto-detecting SD card partition on BMC…"
          # Find the largest unmounted ext2/3/4 partition on any mmcblk device.
          # Sort by block count (descending) so a multi-partition RPi card picks its largest partition.
          set detect {for p in /dev/mmcblk*p*; do [ -b "$p" ] || continue; grep -q "^$p " /proc/mounts && continue; fs=$(blkid -s TYPE -o value "$p" 2>/dev/null); case "$fs" in ext2|ext3|ext4) :;; *) continue;; esac; n=${p##*/}; sz=$(cat /sys/class/block/$n/size 2>/dev/null || echo 0); echo "$sz $p"; done | sort -rn | head -1 | awk '{print $2}'}
          lassign [bmc_cmd $detect] _rc2 dev
          set dev [string trim $dev]
          if {$dev eq ""} {
            die "No SD card found on BMC (no unmounted ext2/3/4 mmcblk partition).\nInsert an SD card with an ext2/3/4 partition, or set BMC_SDCARD_DEV in bootstrap-config.kv."
          }
          say "  Auto-detected: $dev"
        }
        say "  Mounting $dev at $sdcard_mount…"
        lassign [bmc_cmd "mkdir -p $sdcard_mount && mount $dev $sdcard_mount && echo ok || echo fail"] _rc3 mnt2_out
        if {![string match "*ok*" $mnt2_out]} {
          die "Failed to mount $dev at $sdcard_mount: $mnt2_out\nCheck BMC_SDCARD_DEV or the SD card filesystem."
        }
      }
      lassign [bmc_cmd "mkdir -p $::BMC_IMAGE_DIR && echo ok || echo fail"] _rc4 mkdir_out
      if {![string match "*ok*" $mkdir_out]} {
        die "Failed to create image directory $::BMC_IMAGE_DIR on BMC: $mkdir_out"
      }

      # Download and prepare each distinct image type.
      # .xz images are decompressed to .img on the BMC (tpi flash can't decompress in RAM).
      # The .xz is deleted after decompression to reclaim space.
      set type_to_path [dict create]
      for {set i 1} {$i <= $::NODE_COUNT} {incr i} {
        set type [image_type_for $i]
        if {[dict exists $type_to_path $type]} continue
        if {![dict exists $manifest $type]} {
          die "Unknown image type '$type' for node $i. Available: [join [dict keys $manifest] {, }]"
        }
        set entry    [dict get $manifest $type]
        set url      [dict get $entry url]
        set expected [string tolower [string trim [dict get $entry sha256]]]
        set fname    [file tail $url]
        set dest_dl  "$::BMC_IMAGE_DIR/$fname"
        set is_xz    [string match "*.xz" $fname]
        set dest_img [expr {$is_xz ? [file rootname $dest_dl] : $dest_dl}]

        # If a pre-decompressed .img already exists, use it directly — no SHA256 check
        # since it was produced from a previously verified .xz.
        if {$is_xz} {
          lassign [bmc_cmd "test -f [list $dest_img] && echo exists || echo missing"] _rc img_chk
          if {[string match "*exists*" $img_chk]} {
            say "  BMC: raw image already present: [file tail $dest_img]"
            dict set type_to_path $type $dest_img
            continue
          }
        }

        # Ensure the downloaded (.xz or raw) file is cached and SHA256-verified
        set need_dl 1
        lassign [bmc_cmd "test -f [list $dest_dl] && echo exists || echo missing"] _rc4 dl_chk
        if {[string match "*exists*" $dl_chk]} {
          say "  BMC cache hit: [file tail $dest_dl] — verifying SHA256…"
          set _tv [clock seconds]
          lassign [bmc_cmd "sha256sum [list $dest_dl]" 300] _rc5 sum_out
          set actual [string tolower [string trim [lindex [split $sum_out " "] 0]]]
          if {$actual eq $expected} {
            say "  SHA256 OK ([elapsed [expr {[clock seconds] - $_tv}]])"; set need_dl 0
          } else {
            say "  SHA256 mismatch — re-downloading (cached: $actual, expected: $expected)"
            bmc_cmd "rm -f [list $dest_dl]"
          }
        }

        if {$need_dl} {
          say "  BMC downloading (type=$type): $url"
          set _td [clock seconds]
          lassign [bmc_stream "curl -fL --progress-bar -o [list $dest_dl] [list $url] 2>&1" 3600] dl_rc _dl_out
          if {$dl_rc != 0} {
            bmc_cmd "rm -f [list $dest_dl]"
            die "BMC download failed for type '$type' (exit $dl_rc)"
          }
          say "  Downloaded in [elapsed [expr {[clock seconds] - $_td}]]."
          say "  Verifying SHA256 on BMC…"
          set _tv [clock seconds]
          lassign [bmc_cmd "sha256sum [list $dest_dl]" 300] _rc6 sum_out2
          set actual [string tolower [string trim [lindex [split $sum_out2 " "] 0]]]
          if {$actual ne $expected} {
            bmc_cmd "rm -f [list $dest_dl]"
            die "SHA256 mismatch after BMC download for type '$type' — file deleted.\n  got:      $actual\n  expected: $expected\nThis may indicate a corrupted download. Do not proceed."
          }
          say "  SHA256 OK ([elapsed [expr {[clock seconds] - $_tv}]])"
        }

        # Decompress .xz → .img (tpi flash cannot handle compressed images in RAM)
        if {$is_xz} {
          say "  Decompressing on BMC: [file tail $dest_dl] → [file tail $dest_img] (.xz deleted after)"
          set _txz [clock seconds]
          lassign [bmc_stream "xzcat [list $dest_dl] > [list $dest_img] && rm -f [list $dest_dl] && echo ok || echo fail" 3600] _rxz rxz_out
          if {![string match "*ok*" $rxz_out]} {
            bmc_cmd "rm -f [list $dest_img] [list $dest_dl]"
            die "Decompression failed for type '$type'"
          }
          say "  Decompression complete. ([elapsed [expr {[clock seconds] - $_txz}]])"
        }

        dict set type_to_path $type $dest_img
      }

      # Flash each node using the BMC-local image path
      say "Flashing $::NODE_COUNT nodes from BMC SD card…"
      for {set i 1} {$i <= $::NODE_COUNT} {incr i} {
        set type [image_type_for $i]
        set path [dict get $type_to_path $type]
        say "  Node $i of $::NODE_COUNT (type=$type)…"
        set _tn [clock seconds]
        tpi_flash_node_bmc $i $path
        say "  Node $i: done. ([elapsed [expr {[clock seconds] - $_tn}]])"
      }
      say "A3: All nodes flashed via BMC."
    }

    default {
      die "Unknown FLASH_MODE '$::FLASH_MODE'. Valid: skip, image, download, local, bmc"
    }
  }
}

# ----- Stage  A4 -------
proc stage_A4_power_on_and_discover {dry stateRef} {
  upvar $stateRef state
  say "A4: Power ON nodes sequentially and discover IPs"

  for {set i 1} {$i <= $::NODE_COUNT} {incr i} {
    set name "${::NODE_PREFIX}$i"
    set known [state_get $state $name ""]

    if {$dry} {
      if {$known ne ""} {
        say "DRY: tpi power on -n $i; wait for $known to boot (IP already known)"
      } else {
        say "DRY: tpi power on -n $i; scan $::SUBNET for new SSH host; map to $name"
      }
      continue
    }

    if {$known ne ""} {
      # IP already discovered from a prior run — power on and wait for SSH.
      say "  $name: IP already known ($known) — powering on and waiting for SSH…"
      tpi_power $i "on"
      set deadline [expr {[clock seconds] + 150}]
      set up 0
      while {[clock seconds] < $deadline} {
        set chk [string trim [sh "timeout 1 bash -c 'echo >/dev/tcp/$known/22' 2>/dev/null && echo ok || echo no"]]
        if {$chk eq "ok"} { set up 1; break }
        after 5000
      }
      if {!$up} { die "$name did not come up within 150 s at $known.\nFix then rerun --from A4." }
      say "  $name up at $known"
      continue
    }

    # Snapshot which IPs are already on the subnet so we can detect the newcomer.
    say "  Scanning baseline before powering on $name…"
    set baseline [discover_nodes $::SUBNET]
    if {[llength $baseline]} {
      say "  Existing hosts: [join $baseline {, }]"
    } else {
      say "  No existing SSH hosts on subnet."
    }

    tpi_power $i "on"

    # Wait for the new node to appear. No fixed sleep — each nmap scan in
    # wait_for_new_ssh_host takes a few seconds and provides natural pacing.
    say "  Waiting for $name to boot and appear on network (up to 150 s)…"
    set ip [wait_for_new_ssh_host $baseline $::SUBNET $::DEFAULT_USER $::DEFAULT_PASS 150]

    if {$ip eq ""} {
      die "Could not discover IP for $name within 150 s.\nCheck: power LED on, DHCP running, subnet correct.\nFix then rerun --from A4, or add \"$name=<ip>\" to $::STATE_FILE and rerun --from A5."
    }
    state_put state $name $ip

    # Extract MAC from the laptop's ARP table (populated by the SSH probe above).
    # Used to help operator configure static DHCP reservations in their router.
    set mac [string trim [sh "ip neigh show $ip 2>/dev/null | grep -oE '(\[0-9a-f\]{2}:){5}\[0-9a-f\]{2}'"]]
    if {$mac ne ""} {
      state_put state "${name}_mac" $mac
      say "  $name → $ip  (MAC $mac)"
    } else {
      say "  $name → $ip"
    }
  }

  # Print DHCP reservation summary so the operator can lock in stable IPs.
  say "---"
  say "DHCP reservation summary — configure in your router for stable IPs after power cycles:"
  for {set i 1} {$i <= $::NODE_COUNT} {incr i} {
    set name "${::NODE_PREFIX}$i"
    set ip  [state_get $state $name    "?"]
    set mac [state_get $state "${name}_mac" "unknown"]
    say "  $name  MAC=$mac  →  $ip"
  }
  set bmc_ip  [state_get $state "bmc_ip"  "?"]
  set bmc_mac [state_get $state "bmc_mac" "unknown"]
  say "  turingpi (BMC)  MAC=$bmc_mac  →  $bmc_ip"
  say "---"
}

# ----- Stage  A5 -------
proc stage_A5_name_password_reboot {dry stateRef} {
  upvar $stateRef state
  say "A5: Set hostname + password + reboot"

  if {$dry} {
    say "DRY: would set NEW_PASS (no prompt), apply hostnames rk1-node{1..$::NODE_COUNT}, and reboot each"
    for {set i 1} {$i <= $::NODE_COUNT} {incr i} {
      set name "${::NODE_PREFIX}$i"
      set ip [state_get $state $name ""]
      if {$ip eq ""} { set ip "<discovered-ip-for-$name>" }
      say "DRY: $name ($ip): chpasswd, hostnamectl set-hostname $name, add 127.0.1.1 entry, reboot"
    }
    return
  }

  if {$::NEW_PASS eq ""} {
    set ::NEW_PASS [ask_secret "New password for all RK1 nodes: "]
  }

  for {set i 1} {$i <= $::NODE_COUNT} {incr i} {
    set name "${::NODE_PREFIX}$i"
    set ip [state_get $state $name ""]
    if {$ip eq ""} { die "Missing IP for $name; rerun --from A4" }
    if {[check_node_named $ip $name $::DEFAULT_USER $::NEW_PASS]} {
      say "  $name already configured"; continue
    }
    set cmds [list \
      "echo '$::DEFAULT_USER:$::NEW_PASS' | sudo chpasswd" \
      "sudo hostnamectl set-hostname $name" \
      "echo '127.0.1.1 $name' | sudo tee -a /etc/hosts >/dev/null" \
      "sudo reboot" \
    ]
    set rc [ssh_shell $ip $::DEFAULT_USER $::DEFAULT_PASS $cmds]
    if {$rc != 0} {
      die "Could not SSH to $name ($ip) as $::DEFAULT_USER with DEFAULT_PASS.\nNodes must start at factory defaults (DEFAULT_PASS='$::DEFAULT_PASS').\nIf nodes have a non-default password, set DEFAULT_PASS=<current> in bootstrap-config.kv or run teardown first."
    }
    say "  waiting for $name to return…"
    after 10000
    set deadline [expr {[clock seconds] + 120}]
    set up 0
    while {[clock seconds] < $deadline} {
      if {[ssh_ok $ip $::DEFAULT_USER $::NEW_PASS "hostname"] == 0} { set up 1; break }
      after 5000
    }
    if {!$up} {
      die "$name did not return within 120 s after reboot.\nCheck power and network, then rerun --from A5."
    }
    say "  $name is back"
  }
}

# ----- Stage  A6 -------
proc stage_A6_write_hosts_on_laptop {dry stateRef} {
  upvar $stateRef state
  say "A6: Update /etc/hosts on laptop"
  set args {}
  for {set i 1} {$i <= $::NODE_COUNT} {incr i} {
    set name "${::NODE_PREFIX}$i"
    set ip [state_get $state $name ""]
    if {$ip eq ""} { say "  WARNING: no IP for $name in state — skipping"; continue }
    lappend args $ip $name
    say "  [expr {$dry ? {DRY: } : {}}]$ip  $name"
  }
  if {$dry || [llength $args] == 0} return
  set flat [join $args " "]
  set rc [catch {sh "sudo [file dirname [info script]]/bootstrap-host-helper.sh hosts-append $flat"} out]
  if {$rc} { say "WARNING: /etc/hosts update failed: $out" } else { say "  /etc/hosts updated" }
}

# ----- Stage  A7 -------
proc stage_A7_ephemeral_registry_phaseA {dry stateRef} {
  upvar $stateRef state
  set reg "${::NODE_PREFIX}$::REGISTRY_NODE_IDX"
  set ip [state_get $state $reg ""]

  say "A7: Ephemeral registry on $reg (port $::REGISTRY_PORT)"

  if {$dry} {
    if {$ip eq ""} { set ip "<ip-$reg>" }
    say "DRY: would on $reg ($ip):"
    say "DRY:   apt-get install -y docker.io (if needed)"
    say "DRY:   systemctl enable --now docker"
    say "DRY:   docker rm -f registry || true"
    say "DRY:   docker run -d --name registry --restart=always -p $::REGISTRY_PORT:$::REGISTRY_PORT registry:2"
    return
  }

  if {$ip eq ""} { die "Missing IP for $reg; rerun --from A4" }

  set cmds [list \
    "if ! command -v docker >/dev/null 2>&1; then sudo apt-get update && sudo DEBIAN_FRONTEND=noninteractive apt-get install -y docker.io; fi" \
    "sudo systemctl enable --now docker" \
    "sudo docker rm -f registry >/dev/null 2>&1 || true" \
    "sudo docker run -d --name registry --restart=always -p $::REGISTRY_PORT:$::REGISTRY_PORT registry:2" \
  ]
  ssh_shell $ip $::DEFAULT_USER $::NEW_PASS $cmds
  after 1000
  if {[check_registry_http_up $ip $::REGISTRY_PORT]} { say "  registry HTTP OK" } else { say "  WARNING: registry not reachable yet; check docker on $reg" }
}


# ---------- Rediscover ----------
# Scans the subnet, identifies every node by its SSH hostname, updates the state
# file, and rewrites the node entries in /etc/hosts.  No power cycling, no
# password changes.  Handles IP drift after DHCP reassignment.
# Also re-discovers the BMC and refreshes the turingpi.local /etc/hosts entry.
proc do_rediscover {dry stateRef} {
  upvar $stateRef state
  say "Rediscover mode: scanning $::SUBNET for nodes and BMC…"

  if {$dry} {
    say "DRY: would scan $::SUBNET; identify nodes by SSH hostname; update state + /etc/hosts"
    return
  }

  if {$::NEW_PASS eq ""} {
    set ::NEW_PASS [ask_secret "Current node password: "]
  }

  # ---- Re-discover BMC ----
  say "  Scanning for BMC…"
  set bmc [find_bmc $::SUBNET]
  if {$bmc eq "" && $::BMC_HOST ne ""} {
    say "  BMC not found via nmap hostname — using BMC_HOST from config: $::BMC_HOST"
    set bmc $::BMC_HOST
  }
  if {$bmc ne ""} {
    set old_bmc [state_get $state "bmc_ip" ""]
    if {$old_bmc ne $bmc} { say "  BMC: $old_bmc → $bmc (updated)" } else { say "  BMC: $bmc (unchanged)" }
    state_put state "bmc_ip" $bmc
    set ::BMC_HOST $bmc
    set bmc_mac [string trim [sh "ip neigh show $bmc 2>/dev/null | grep -oE '(\[0-9a-f\]{2}:){5}\[0-9a-f\]{2}'"]]
    if {$bmc_mac ne ""} { state_put state "bmc_mac" $bmc_mac }
  } else {
    say "  WARNING: BMC not found on subnet — turingpi.local not updated"
  }

  # ---- Re-discover nodes by SSH hostname ----
  say "  Scanning for SSH hosts…"
  set candidates [discover_nodes $::SUBNET]
  say "  Found [llength $candidates] SSH host(s)"

  set name_to_ip [dict create]
  foreach ip $candidates {
    set found_name ""
    catch {
      spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                -o ConnectTimeout=3 $::DEFAULT_USER@$ip "hostname"
      expect {
        -re "(P|p)assword:"   { send "$::NEW_PASS\r"; exp_continue }
        -re "Are you sure.*"  { send "yes\r"; exp_continue }
        -re {([^\r\n]+)\r?\n} { set found_name $expect_out(1,string); exp_continue }
        timeout               { catch {close} }
        eof                   { }
      }
    }
    set found_name [string trim $found_name]
    if {$found_name ne ""} { dict set name_to_ip $found_name $ip }
  }

  # ---- Update state and build fresh /etc/hosts args ----
  set hosts_args {}
  for {set i 1} {$i <= $::NODE_COUNT} {incr i} {
    set name "${::NODE_PREFIX}$i"
    if {[dict exists $name_to_ip $name]} {
      set ip [dict get $name_to_ip $name]
      set old [state_get $state $name "none"]
      if {$old ne $ip} { say "  $name: $old → $ip" } else { say "  $name: $ip (unchanged)" }
      state_put state $name $ip
      lappend hosts_args $ip $name
      # Refresh MAC
      set mac [string trim [sh "ip neigh show $ip 2>/dev/null | grep -oE '(\[0-9a-f\]{2}:){5}\[0-9a-f\]{2}'"]]
      if {$mac ne ""} { state_put state "${name}_mac" $mac }
    } else {
      say "  WARNING: $name not found — keeping existing state entry"
    }
  }

  # ---- Rewrite /etc/hosts (remove stale, add fresh) ----
  set node_names {}
  for {set i 1} {$i <= $::NODE_COUNT} {incr i} { lappend node_names "${::NODE_PREFIX}$i" }
  set helper "sudo [file dirname [info script]]/bootstrap-host-helper.sh"
  sh "$helper hosts-remove [join $node_names { }] turingpi.local"
  if {[llength $hosts_args] > 0} {
    set rc [catch {sh "$helper hosts-append [join $hosts_args { }]"} out]
    if {$rc} { say "WARNING: /etc/hosts node update failed: $out" }
  }
  if {$bmc ne ""} {
    set rc [catch {sh "$helper hosts-append $bmc turingpi.local"} out]
    if {$rc} { say "WARNING: /etc/hosts BMC update failed: $out" }
  }

  say "Rediscovery complete."
}

# ---------- run ----------
# Show help if no args and no state yet (friendly)
if {$argc == 0} {
  puts "Tip: run './bootstrap-turingpi.exp --help' for usage."
}

say "Starting bootstrap (dry-run=$dryrun, from=$fromStage, to=$toStage, phase=$phase, flash=$FLASH_MODE)…"
if {[info exists ::env(BOOTSTRAP_NO_AUTO_STATE)] && $STATE_FILE eq $_default_state_file} {
  set state [dict create]
} else {
  set state [kv_load $STATE_FILE]
}
# Restore BMC_HOST from a previous run so tpi commands work even if A1 is skipped
if {$BMC_HOST eq "" && [dict exists $state "bmc_ip"]} {
  set BMC_HOST [dict get $state "bmc_ip"]
  say "Restored BMC host from state: $BMC_HOST"
}
set _t0 [clock seconds]
set _stage_log {}

if {$rediscover} {
  set _tr [clock seconds]
  do_rediscover $dryrun state
  if {!$dryrun} { kv_save $STATE_FILE $state }
  say "Done. ([elapsed [expr {[clock seconds] - $_tr}]])"
  exit 0
}

for {set idx $startIdx} {$idx <= $endIdx} {incr idx} {
  set s [lindex $STAGES $idx]
  say "Stage $s"
  set _ts [clock seconds]
  switch -- $s {
    "A0_bmc_firmware"             { stage_A0_bmc_firmware            $dryrun state }
    "A1_find_bmc"                 { stage_A1_find_bmc                $dryrun state }
    "A2_poweroff_all"             { stage_A2_poweroff_all            $dryrun state }
    "A3_flash_optional"           { stage_A3_flash_optional          $dryrun state }
    "A4_power_on_and_discover"    { stage_A4_power_on_and_discover   $dryrun state }
    "A5_name_password_reboot"     { stage_A5_name_password_reboot    $dryrun state }
    "A6_write_hosts_on_laptop"    { stage_A6_write_hosts_on_laptop   $dryrun state }
    "A7_ephemeral_registry_phaseA" { stage_A7_ephemeral_registry_phaseA $dryrun state }
    default { say "  (unimplemented stage placeholder)" }
  }
  set _stage_secs [expr {[clock seconds] - $_ts}]
  say "  ↳ $s: [elapsed $_stage_secs] (total [elapsed [expr {[clock seconds] - $_t0}]])"
  lappend _stage_log [list $s $_stage_secs]
  if {!$dryrun} { kv_save $STATE_FILE $state }
}

set _total [expr {[clock seconds] - $_t0}]
say ""
say "── Timing summary ──────────────────────────────"
foreach entry $_stage_log {
  lassign $entry _sn _ss
  say [format "  %-38s %s" $_sn [elapsed $_ss]]
}
say [format "  %-38s %s" "TOTAL" [elapsed $_total]]
say "────────────────────────────────────────────────"
