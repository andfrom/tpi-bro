# bootstrap-config.kv — copy to bootstrap-config.kv and edit for your setup.
# Auto-loaded by bootstrap-turingpi-cluster.exp if no --config flag is given.
# Command-line flags always override values set here.

# ---------- Network ----------
SUBNET=192.168.1.0/24

# ---------- Nodes ----------
NODE_COUNT=4
NODE_PREFIX=rk1-node
# Which node runs k3s server (Phase B reference only; does not affect flashing)
SERVER_NODE_IDX=1

# ---------- Credentials ----------
DEFAULT_USER=ubuntu
DEFAULT_PASS=ubuntu
# NEW_PASS=  (leave blank to be prompted at runtime)

# ---------- Registry ----------
REGISTRY_NODE_IDX=1
REGISTRY_PORT=5000

# ---------- State ----------
STATE_FILE=./bootstrap-state.kv

# ---------- Flash ----------
# FLASH_MODE=skip         # skip flashing (default)
# FLASH_MODE=image        # upload image files from this laptop via tpi flash --image-path
# FLASH_MODE=local        # use image already on BMC SD card via tpi flash --local
# FLASH_MODE=bmc          # SSH to BMC, curl image to SD card there, then flash --local
#                         # (avoids uploading large files from laptop; SD card must be present)
# FLASH_MODE=download     # fetch from manifest to laptop cache, verify SHA256, then flash

# Default image for all nodes (required when FLASH_MODE=image):
# IMAGE_DEFAULT=/path/to/ubuntu-rk1.img

# Per-node image overrides (override IMAGE_DEFAULT for that node only):
# IMAGE_1=/path/to/server.img
# IMAGE_2=/path/to/worker.img
# IMAGE_3=/path/to/worker.img
# IMAGE_4=/path/to/worker.img

# Manifest file for download/bmc modes (copy images-manifest.kv.example to get started):
# MANIFEST_FILE=./images-manifest.kv

# ---------- BMC ----------
# BMC_HOST=  (leave blank to auto-discover via nmap in A1)
# BMC_HOST=192.168.1.163

# SSH credentials for BMC (used by --flash bmc to run curl on the BMC):
# BMC_USER=root
# BMC_PASS=  (leave blank for key-based or passwordless root auth — typical for TuringPi BMC)

# SD card on BMC for storing images (--flash bmc):
# BMC_IMAGE_DIR=/mnt/sdcard/tpi-images
# BMC_SDCARD_DEV=  (blank = auto-detect largest unmounted ext2/3/4 mmcblk partition)
